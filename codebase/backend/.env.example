# Copy thành .env, không commit .env (đã có trong .gitignore)

# Để true thì chạy được ngay bằng mock, không cần key, không tốn credit.
USE_MOCKS=true

# LLM — ngân sách cả dự án là $5, xem bảng phân tầng trong codebase/README.md
OPENAI_API_KEY=
MODEL_FAST=gpt-5-nano
MODEL_STANDARD=gpt-5-mini
MODEL_JUDGE=gpt-5

# Voice
SPEECHMATICS_API_KEY=
FPT_AI_API_KEY=

# Slide của bài đang học (đường dẫn tuyệt đối tới file PDF)
SLIDES_PDF=
# Hoặc cả thư mục slide: mỗi file PDF là một bài trong thư viện.
# Tên hiển thị của từng bài đặt trong knowledge/decks.json.
SLIDES_DIR=

# Đăng nhập cho bản thử nghiệm: "ten:matkhau" cách nhau dấu phẩy.
# Để trống = tắt đăng nhập (chạy máy cá nhân, chạy test).
MEMBERS=
# Khoá ký token. Để trống thì mỗi lần khởi động lại server, mọi người phải đăng
# nhập lại. Tạo: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=

# priority nhanh gấp ~3 lần nhưng đắt hơn; default để tiết kiệm credit
OPENAI_SERVICE_TIER=priority
TTS_SPEED=1.5

# "slide" hoặc "code" — đổi chế độ bài học
LESSON_MODE=slide
