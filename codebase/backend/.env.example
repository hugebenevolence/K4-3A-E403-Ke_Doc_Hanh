# Copy thành .env, không commit .env (đã có trong .gitignore)

# Để true thì chạy được ngay bằng mock, không cần key, không tốn credit.
USE_MOCKS=true

# LLM — ngân sách cả dự án là $5, xem bảng phân tầng trong codebase/README.md
OPENAI_API_KEY=
MODEL_FAST=gpt-5-nano
MODEL_STANDARD=gpt-5-mini
MODEL_JUDGE=gpt-5

# Voice
SPEECHMATICS_API_KEY=
FPT_AI_API_KEY=
